.ipynb_checkpoints/

# Playwright / harness toolchain, installed locally, not part of the product.
# package.json is ignored deliberately: `npm init -y` writes the git remote URL
# into it, and this repo's remote carries a PAT. GitHub push protection blocked
# exactly that push once already. Recreate the toolchain with:
#   npm install playwright && npx playwright install chromium --with-deps
node_modules/
package.json
package-lock.json

# Python bytecode — never ship this inside the pack
__pycache__/
*.pyc

# Render evidence: the A/B arms the owner must look at are committed.
# The four control-repeat images are NOT — they were proved pixel-identical to
# A_baseline (pairwise MSE exactly 0), so committing ~42 MB of duplicates adds
# nothing. Their value is in metrics_control.json, which IS committed.
results/ws4/A2_control_repeat/*.png
results/ws4/A3_control_repeat/*.png
results/ws4/A4_control_repeat/*.png
results/ws4/B2_no_vae_roundtrip_repeat/*.png
